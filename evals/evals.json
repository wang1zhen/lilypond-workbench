    {
      "id": 6,
      "prompt": "把 MIDI 和 ABC 转成整洁的 LilyPond，并制作一份含中文说明的 LaTeX PDF。",
      "expected": ["converted and semantically reviewed scores", "LuaLaTeX lilypond-book document", "non-empty PDF"],
      "pytest_nodes": [
        "tests/test_integration.py::test_import_musicxml_and_abc",
        "tests/test_integration.py::test_import_generated_midi",
        "tests/test_integration.py::test_latex_document_build"
      ]
    },
    {
      "id": 7,
      "prompt": "分析弦乐总谱中 violin、viola 和 cello 的谱号使用，保留总谱源文件，为分谱生成稳定且不频繁切换的自动谱号轨。",
      "expected": ["semantic written-pitch index", "source-located clef reports", "stable clef hysteresis", "successfully compiled parts"],
      "pytest_nodes": ["tests/test_integration.py::test_automatic_cello_clef_track_compiles"]
