    },
    {
      "id": 4,
      "prompt": "从弦乐总谱生成独立分谱并批量输出 PDF。",
      "expected": ["reviewed schema v3 manifest", "shared source of truth", "one PDF per part"],
      "pytest_nodes": ["tests/test_integration.py::test_part_extraction_compiles"]
    },
    {
      "id": 5,
      "prompt": "分析这份 MusicXML 的和声，添加和弦名和罗马数字。",
